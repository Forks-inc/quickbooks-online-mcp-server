# --- QuickBooks Online Connection ---
QUICKBOOKS_CLIENT_ID=your_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_client_secret_here
QUICKBOOKS_ENVIRONMENT=sandbox
# If you already have active tokens, provide them below
QUICKBOOKS_REFRESH_TOKEN=your_refresh_token_here
QUICKBOOKS_REALM_ID=your_company_id_here
QUICKBOOKS_REDIRECTURI=http://localhost:8000/callback

# --- Remote Security / Seguridad Remota ---
# Master token: protects endpoints AND is the OAuth2 login password
# Token maestro: protege endpoints Y es la contraseña del formulario OAuth2
MCP_SECURITY_TOKEN=generate-a-long-random-string-here

# --- OAuth2 / Custom Connectors ---
# Public URL where the MCP server is accessible (required for OAuth2 metadata)
# URL pública donde se accede al servidor MCP (requerido para metadatos OAuth2)
MCP_SERVER_URL=https://mcp.yourdomain.com

# --- Server Transport / Transporte del Servidor ---
# Options: stdio (local), sse, streamable-http (remote+OAuth2)
MCP_TRANSPORT=stdio
# Server port & host (remote only) / Puerto y host (solo remoto)
PORT=8000
HOST=0.0.0.0
