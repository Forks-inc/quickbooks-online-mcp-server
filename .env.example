# ==========================================
# 🛑 VARIABLES REQUERIDAS (Configurar en Dokploy)
# ==========================================

# QuickBooks API Keys
QUICKBOOKS_CLIENT_ID=tu_client_id_aca
QUICKBOOKS_CLIENT_SECRET=tu_client_secret_aca
QUICKBOOKS_ENVIRONMENT=production

# Server Config (Requerido para OAuth2 y SSE)
MCP_SERVER_URL=https://tu-mcp-qbo.midominio.com
MCP_TRANSPORT=sse
MCP_SECURITY_TOKEN=una-clave-secreta-larga-para-claude

# ==========================================
# ⚡ VARIABLES AUTOMÁTICAS (No tocar)
# ==========================================
# El servidor llenará estas variables solo al primer login
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_REALM_ID=

# ==========================================
# 🛠️ OPCIONALES / DESARROLLO
# ==========================================
PORT=8000
HOST=0.0.0.0
# Solo para el script local 'pnpm run auth'
QUICKBOOKS_REDIRECTURI=http://localhost:8000/callback
