# --- QuickBooks Online Connection ---
QUICKBOOKS_CLIENT_ID=your_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_client_secret_here
QUICKBOOKS_ENVIRONMENT=production
QUICKBOOKS_REDIRECTURI=http://localhost:8000/callback

# If you use the Claude/Remote (SSE) flow, these will be populated automatically
# Si usas el flujo de Claude/Remoto (SSE), estos se llenarán automáticamente
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_REALM_ID=

# --- Remote Security / Seguridad Remota ---
# Master token: protects endpoints if no OAuth2 is used
# Token maestro: protege los endpoints si no se usa OAuth2
MCP_SECURITY_TOKEN=generate-a-long-random-string-here

# --- OAuth2 / Custom Connectors ---
# Public URL where the MCP server is accessible (required for OAuth2 metadata)
# URL pública donde se accede al servidor MCP (requerido para metadatos OAuth2)
MCP_SERVER_URL=https://mcp.yourdomain.com

# --- Server Transport / Transporte del Servidor ---
# Options: stdio (for local/desktop), sse (for remote/Claude Web/Mobile)
# Opciones: stdio (local/escritorio), sse (remoto/Claude Web/Móvil)
MCP_TRANSPORT=stdio

# Server port & host (remote/SSE only)
PORT=8000
HOST=0.0.0.0
